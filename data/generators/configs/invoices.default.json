    "first_time_late": 0.75,
    "chronic_delinquent": 0.8,
    "disputing": 0.95,
    "silent": 0.25
  },

  "language_mix": { "en": 0.62, "hinglish": 0.38 },

  "reminder_ladder": {
    "max_rungs": 3,
    "spacing_days": 7,
