    {
      "label": "card-acquirer-b-degradation",
      "method": "card",
      "issuer": null,
      "route_id": "rt_card_acq_2",
      "starts_at": "2026-08-31T14:00:00+05:30",
      "ends_at": "2026-08-31T20:00:00+05:30",
      "degraded_success_rate": 0.48,
      "dominant_failure_code": "TECHNICAL_DECLINE",
      "dominant_share": 0.6,
      "note": "Deliberately harder: route-level rather than issuer-level, shorter, milder, lower volume. Engine 1 may well miss this one, and a missed detection reported honestly is worth more than a dataset tuned so nothing is ever missed."
