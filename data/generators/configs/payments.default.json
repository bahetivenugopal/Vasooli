  "decoys": [
    {
      "label": "mobikwik-wallet-low-volume-decoy",
      "method": "wallet",
      "issuer": "MOBK",
      "issuer_name": "Mobikwik Wallet",
      "route_id": "rt_wallet_direct",
      "attempts_per_day": 3,
      "baseline_success_rate": 0.74,
      "note": "No degradation is injected here. Volume is so low that ordinary variance produces windows with zero successes. Flagging this corridor is a false positive and must be reported as one."
