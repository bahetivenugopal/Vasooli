# Vasooli — environment configuration
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# Razorpay — TEST MODE ONLY
# ---------------------------------------------------------------------------
# Get these from the Razorpay Dashboard in **Test Mode**:
#   Account & Settings -> API Keys -> Generate Test Key
#
# The key id MUST start with `rzp_test_`. A key starting with `rzp_live_` does
# not belong in this project, in any environment, at any time. If a live key
# ever lands here, stop and rotate it immediately.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — webhook signature verification (Dashboard -> Settings -> Webhooks).
# Used to verify the X-Razorpay-Signature header (HMAC-SHA256 over the raw body).
RAZORPAY_WEBHOOK_SECRET=

# How Razorpay calls are fulfilled:
#   simulated - deterministic, offline, driven by local fixtures. The default.
#   test      - real HTTP calls against Razorpay **test mode**.
#
# Simulated is the default because a batch run that depends on live network
# conditions is not reproducible, and a demo that depends on them can fail for
# reasons unrelated to the product. The mode is recorded on every audit entry,
# so it is always visible and never silent. See ADR 0004.
RAZORPAY_MODE=simulated

# ---------------------------------------------------------------------------
# Google Gemini — the reasoning layer
# ---------------------------------------------------------------------------
# https://aistudio.google.com/apikey
#
# Leave blank to run entirely on deterministic fallbacks — the project is
# designed to complete a full batch with no keys at all.
GEMINI_API_KEY=

# Resolved once, here. Never hardcode a model at a call site.
# GA rather than the `-preview` id the change request named: a preview id can be
# retired without notice. Both were verified live on 2026-09-03 and both work.
# See docs/adr/0002-gemini-provider-and-deterministic-fallbacks.md
GEMINI_MODEL=gemini-3.1-flash-lite

# When true, skip the provider entirely and use registered deterministic
# fallbacks throughout. Every result is then audited as `source: deterministic`.
LLM_DETERMINISTIC_ONLY=false

# Where cached provider responses are persisted. Relative paths anchor to
# apps/api/. The cache is what keeps development re-runs and pre-demo seed runs
# from burning the daily free-tier quota, and what makes a batch reproducible
# without re-spending it.
LLM_CACHE_PATH=.llm_cache

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite by default — deliberately zero-setup for the hackathon. Swapping this
# connection string is all that is needed to move to Postgres later; do not
# build that now.
#
# Path is relative to apps/api/. The .db file is gitignored.
DATABASE_URL=sqlite:///./vasooli.db

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# `development` | `production`
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Batch demo
# ---------------------------------------------------------------------------
# Default seed for the synthetic data generator. Every reported recovery number
# travels with its batch_id and seed — that is what makes it verifiable rather
# than cherry-picked.
DEMO_SEED=42

# ---------------------------------------------------------------------------
# Frontend (apps/web) — Next.js needs NEXT_PUBLIC_ to expose a var to the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
